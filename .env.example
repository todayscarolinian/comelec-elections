# Copy to .env.local. Never commit real secrets.
# Generate AUTH_SECRET locally: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional on Vercel. Replace or unset this localhost URL in deployed environments.
AUTH_URL=http://localhost:3000

# Placeholder only; replace with the client's confirmed Google Workspace domain.
# An absent/empty domain denies all sign-ins. There is no permissive fallback.
ALLOWED_HOSTED_DOMAIN=example.com
